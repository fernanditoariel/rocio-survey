# API Base URL (para producción)
NEXT_PUBLIC_API_URL=https://tu-dominio.com

# Email Configuration (opcional, para enviar respuestas por email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-contraseña-de-app

# Email destinatario (donde se envían las respuestas)
